# Copy this file to .env (inside the frontend folder) and fill it in.
# Leave VITE_API_URL empty in development: the Vite proxy forwards /api to FastAPI.
VITE_API_URL=
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Add http://localhost:5173 under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
